# Токен от @BotFather (обязательно)
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram ID админов через запятую (доступ к /stats). Узнать: @userinfobot
ADMIN_IDS=

# Где хранить БД и последние фото (в Docker это volume ./data)
DATA_DIR=data

# Вырезать фон у фото: auto|on|off (нужен pip install -r requirements-rembg.txt)
REMOVE_BG=auto

# Параметры стикера (менять осторожно — это требования Telegram)
STICKER_FPS=30
STICKER_DURATION=2.8

# --- Режим генерации видео ---
# none      = бесплатный локальный: нейросеть вырезания фона (rembg/u2net) + анимация.
# hf        = БЕСПЛАТНЫЙ публичный Hugging Face Space (image-to-video нейросеть).
#             Очереди/доступность не гарантируются, при ошибке — автооткат на локальный.
# replicate / fal = платные API, как у оригинала (ключ провайдера).
AI_PROVIDER=none
# HF_SPACE=Wan-AI/Wan2.2-TI2V-5B
# HF_API_NAME=/predict
# HF_TOKEN=hf_...
# REPLICATE_API_TOKEN=r8_...
# REPLICATE_MODEL=kwaivgi/kling-v1.6-standard
# FAL_KEY=...
# FAL_MODEL=fal-ai/kling-video/v1.6/standard/image-to-video

# FFMPEG_PATH=/usr/bin/ffmpeg
