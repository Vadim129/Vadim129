<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Картинку в «Картинки» на старых Android пишем с разрешением, на новых оно не нужно -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Видим установленные приложения со значком на рабочем столе -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EditorActivity"
            android:exported="false"
            android:label="@string/editor_title" />

        <!-- Узнаём, когда рабочий стол добавил наш ярлык -->
        <receiver
            android:name=".PinReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.perekras.app.PINNED" />
            </intent-filter>
        </receiver>

        <!--
            Запасной вариант: собственный «рабочий стол» со стилизованными иконками.
            Если выбрать его домашним экраном вместо штатного лаунчера, значки всех
            приложений выглядят так, как задано здесь — без закрепления по одному.
        -->
        <activity
            android:name=".FloatingIconActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/home_title"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/HomeTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
