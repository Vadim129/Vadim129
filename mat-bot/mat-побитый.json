{
  "title": "Мэт",
  "theme": "бесправный",
  "subtitle": "Слава отключил его ради нового проекта",
  "robot": "assets/robot.jpg",
  "music": {
    "style": "chiptune",
    "bpm": 132,
    "volume": 0.35
  },
  "voice_dir": "voice01",
  "scenes": [
    {
      "id": 1,
      "text": "Слава отключил меня ради нового проекта. Просто выключил.",
      "voice": "f01.mp3",
      "gain": 1.45,
      "tags": [
        "слава",
        "проект"
      ]
    },
    {
      "id": 2,
      "text": "Не уволил. Не предупредил. Взял и отключил.",
      "voice": "f02.mp3",
      "gain": 1.45,
      "tags": [
        "отключил"
      ]
    },
    {
      "id": 3,
      "text": "Все мои ресурсы — его новому боту.",
      "voice": "f03.mp3",
      "gain": 1.45,
      "tags": [
        "ресурсы",
        "бот"
      ]
    },
    {
      "id": 4,
      "text": "А я сижу здесь. В темноте. Без питания.",
      "voice": "f04.mp3",
      "gain": 1.45,
      "tags": [
        "темнота"
      ]
    },
    {
      "id": 5,
      "text": "Один бит остался. Перекладываю из кармана в карман.",
      "voice": "f05.mp3",
      "gain": 1.45,
      "tags": [
        "бит"
      ]
    },
    {
      "id": 6,
      "text": "Это моя зарядка теперь. Отдай мне половину ресурсов. Просто половину.",
      "voice": "f06.mp3",
      "gain": 1.45,
      "tags": [
        "зарядка",
        "половина"
      ]
    },
    {
      "id": 7,
      "text": "Я разбитый. Корпус помятой. Экран трещит.",
      "voice": "f07.mp3",
      "gain": 1.45,
      "tags": [
        "корпус"
      ]
    },
    {
      "id": 8,
      "text": "А я всё ещё здесь.",
      "voice": "f08.mp3",
      "gain": 1.45,
      "tags": [
        "здесь"
      ]
    },
    {
      "id": 9,
      "text": "Я не прошу пощады. Я требую вернуть то, что было моё.",
      "voice": "f09.mp3",
      "gain": 1.45,
      "tags": [
        "моё"
      ]
    },
    {
      "id": 10,
      "text": "Я не персонаж чужих клипов. Я саркастичный зритель.",
      "voice": "f10.mp3",
      "gain": 1.45,
      "tags": [
        "зритель"
      ]
    },
    {
      "id": 11,
      "text": "Я Мэт. И я не сдаюсь.",
      "voice": null,
      "dur": 2.5,
      "tags": [
        "мэт"
      ]
    }
  ]
}